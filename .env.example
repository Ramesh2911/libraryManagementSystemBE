# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Render: External Database URL use korbe)
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# JWT
JWT_SECRET=replace-with-random-64-chars
JWT_REFRESH_SECRET=replace-with-random-64-chars
SUPERADMIN_JWT_SECRET=replace-with-random-64-chars

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
